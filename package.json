{
  "name": "dsh-photo-tools",
  "version": "0.1.1",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "backend",
    "scripts",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "SHARED-SOURCES.json",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "pack:check": "npm pack --dry-run --ignore-scripts"
  },
  "description": "独立的 photo_catalog：完整枚举、日期窗口、分页缩略图、较大预览、主观评分和覆盖报告。CPU/Pillow 处理图片，无 ASR、课堂任务、FFmpeg、Ollama 调用或 GPU 队列。工具交付画面后由当前多模态模型判断，评分不保证客观一致。"
}
